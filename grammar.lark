// SIPL grammar. Arithmetic precedence: * before + and -; operators associate left.
start: "begin" statement "end"

?statement: sequence
sequence: simple (";" simple)*

?simple: assignment
       | if_statement
       | while_statement
       | block
       | "skip"                         -> skip_statement

assignment: NAME ":=" arithmetic
if_statement: "if" boolean "then" statement "else" statement
while_statement: "while" boolean "do" statement
block: "begin" statement "end"

?arithmetic: sum
?sum: product
    | sum "+" product                  -> add
    | sum "-" product                  -> subtract
?product: atom
        | product "*" atom             -> multiply
?atom: INTEGER                         -> number
     | NAME                             -> variable
     | "(" arithmetic ")"

?boolean: boolean_or
?boolean_or: boolean_atom
           | boolean_or "|" boolean_atom -> boolean_or_op
?boolean_atom: comparison
             | "~" boolean_atom        -> boolean_not
             | "(" boolean ")"
comparison: arithmetic "=" arithmetic -> equal
          | arithmetic ">" arithmetic -> greater

NAME: /[A-Z]+/
INTEGER: /-?[0-9]+/
%import common.WS
%ignore WS
